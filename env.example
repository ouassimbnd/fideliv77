# Indispensables pour le MVP connecté. Valeurs dans Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret serveur, indispensable pour supprimer complètement les comptes Auth.
# Ne jamais préfixer cette variable par NEXT_PUBLIC_ et ne jamais la committer.
SUPABASE_SERVICE_ROLE_KEY=
